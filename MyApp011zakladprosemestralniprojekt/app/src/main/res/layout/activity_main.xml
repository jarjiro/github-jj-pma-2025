<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top bar -->
    <TextView
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Objednávka 3D tiskárny"
        android:textSize="20sp"
        android:textAlignment="center"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnToggleTheme"
        android:textStyle="bold"/>


    <!-- Toggle theme button -->
    <ImageButton
        android:id="@+id/btnToggleTheme"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@null"
        android:contentDescription="Toggle Theme"
        android:src="@drawable/ic_sun"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="8dp"/>

    <!-- ImageView tiskárny -->
    <ImageView
        android:id="@+id/imagePrinter"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/oiz_m10_tr"/>

    <!-- Typ tiskárny -->
    <TextView
        android:id="@+id/tvPrinterType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Typ tiskárny:"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/imagePrinter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- RadioGroup pro tiskárny -->

    <!-- Vybavení k tiskárně -->

    <!-- Jméno a email -->

    <RadioGroup
        android:id="@+id/radioGroupPrinter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imagePrinter">

        <RadioButton
            android:id="@+id/radioM10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prusa Mk4" />

        <RadioButton
            android:id="@+id/radioM20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ender-3" />

        <RadioButton
            android:id="@+id/radioM30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voron" />

        <RadioButton
            android:id="@+id/radioM40"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BambuLab" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvEquipment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Vybavení k tiskárně:"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/radioGroupPrinter" />

    <LinearLayout
        android:id="@+id/checkBoxLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/radioGroupPrinter">

        <CheckBox
            android:id="@+id/checkSupport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manual pro začátečníky" />

        <CheckBox
            android:id="@+id/checkColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filament" />

        <CheckBox
            android:id="@+id/checkFast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vybavení k 3D tisku" />
    </LinearLayout>

    <EditText android:id="@+id/editName" android:hint="Name" android:layout_width="0dp" android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/checkBoxLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:singleLine="true"
        android:layout_marginTop="8dp"/>

    <EditText android:id="@+id/editEmail" android:hint="Email" android:layout_width="0dp" android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/editName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:singleLine="true"
        android:layout_marginTop="8dp"/>

    <!-- Tlačítko objednat -->

    <!-- Souhrn objednávky -->

    <Button
        android:id="@+id/btnOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Objednat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editEmail" />

    <TextView android:id="@+id/tvSummary" android:text="" android:layout_width="0dp" android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/btnOrder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
